rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /members/{id} {
      allow read, write: if signedIn();
    }

    match /meta/{id} {
      allow read, write: if signedIn();
    }

    // One document per member per session: id = "<memberId>_S<session>".
    // Because "update" is blocked, a second device cannot mark the same member
    // twice in the same session. The server rejects it.
    match /attendance/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.session is int
        && request.resource.data.session >= 1
        && request.resource.data.session <= 12
        && id == request.resource.data.memberId + '_S' + string(request.resource.data.session);
      allow delete: if signedIn();
      allow update: if false;
    }
  }
}
