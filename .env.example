# Copy this file to ".env" and fill in the values from your Firebase web app.
# On Vercel, add the same names under Project Settings > Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Optional. The login email used behind the scenes. Volunteers only type the passcode.
# It must match the user you create in Firebase Authentication.
VITE_ACCESS_EMAIL=volunteer@calibrix2k26.app
